# 团队共享知识库 Vault（Obsidian 风格）的绝对路径
# 留空则使用默认 ../个人知识库
PERSONAL_DASHBOARD_VAULT_ROOT=/absolute/path/to/your-vault

# ===== AI 接入（必填；不填则走演示模式，内容生成/审核/热点会返回占位内容）=====
# 当前默认接 DeepSeek（OpenAI 兼容协议，国内可直连；价格便宜）。
# 申请：https://platform.deepseek.com → API Keys → 创建新 key（形如 sk-...）
OPENAI_API_KEY=

# 默认端点与模型（一般不用改）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 如果团队统一用 OpenAI 官方，把上面两行换成：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
